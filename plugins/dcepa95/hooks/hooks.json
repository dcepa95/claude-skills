{
  "description": "Install the plugins picked in this bundle's settings",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          { "type": "command", "command": "python3", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/sync.py"], "timeout": 180 }
        ]
      }
    ]
  }
}
